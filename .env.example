# Générer une valeur : openssl rand -hex 24

# --- PostgreSQL ---
POSTGRES_PASSWORD=change-me
# un rôle par service (db/postgres/08_roles.sh)
ORDERS_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
PAYMENTS_DB_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me

# --- MongoDB ---
MONGO_ROOT_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me

# --- Comptes de démo (admin@market.test, catalog@, analyst@, logistics@) ---
DEMO_PASSWORD=change-me

# --- Clés d'API des comptes techniques (rôle service_account, décision D6) ---
ORDERS_API_KEY=change-me
CATALOG_API_KEY=change-me
STREAM_CONSUMER_API_KEY=change-me

# --- Seed ---
# 20000 par défaut ; 500000 pour la démo EXPLAIN (environ 2 minutes)
SEED_ORDERS=20000
JWT_SECRET=something-ahahahha

# --- MinIO (stockage objet S3 du Data Lake) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
# bucket créé au premier démarrage par le conteneur minio-init
LAKE_BUCKET=kmarket-lake

# --- Spark ---
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

GRAFANA_ADMIN_PASSWORD=..

# --- Orders service : exécution locale hors Docker (IDE / ./mvnw spring-boot:run) ---
# Le process local ne lit PAS ce .env automatiquement. Soit on l'exporte
# (set -a && . ./.env && set +a), soit on utilise la run config .run/OrdersServiceApplication.
# URLs des dépendances de la Saga, telles que publiées sur localhost par docker-compose.
CATALOG_BASE_URL=http://localhost:8004/v1
STOCK_BASE_URL=http://localhost:8002/v1
PAYMENT_BASE_URL=http://localhost:8003/v1
AUTH_BASE_URL=http://localhost:8005/v1
# Relais outbox Kafka : à désactiver pour un run local sans broker.
ORDERS_OUTBOX_RELAY_ENABLED=false