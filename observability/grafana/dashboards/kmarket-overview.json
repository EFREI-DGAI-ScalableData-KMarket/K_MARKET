    {
      "type": "stat",
      "title": "Stock",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Messages publiés mais pas encore lus, par groupe de consommateurs. Spark n'utilise pas de groupe : son retard est dans la ligne « Flux temps réel ». Cible du sujet : moins de 1 000.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"stock-service\"} * (2 - scalar(count(ALERTS{alertstate=\"firing\",job=\"stock-service\"}) > bool 0 or vector(0)))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ARRÊTÉ",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "DÉGRADÉ",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "ARRÊTÉ",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
